diff --git a/tests/extension/capture.test.ts b/tests/extension/capture.test.ts
new file mode 100644
index 0000000..1c62d11
--- /dev/null
+++ b/tests/extension/capture.test.ts
@@ -0,0 +1,50 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { findTrades, leagueIdFromUrl, toTransaction } from "../../extension/src/capture";
+
+const trade = (id: string, extra: Record<string, unknown> = {}) => ({
+  transaction_id: id, type: "trade", status: "proposed", roster_ids: [1, 4],
+  adds: { "6794": 1 }, drops: { "6794": 4 }, creator: "u1", ...extra,
+});
+const payload = { data: { league_transactions_filtered: [trade("9", { leg: 10, league_id: "123", metadata: { secret: "x" } })] } };
+
+test("finds a pending trade in a GraphQL response and keeps only trade fields", () => {
+  const found = findTrades(payload);
+  assert.equal(found.length, 1);
+  assert.equal(found[0].transactionId, "9");
+  assert.equal(found[0].leagueId, "123");
+  assert.equal(found[0].status, "proposed");
+  assert.deepEqual(found[0].rosterIds, [1, 4]);
+  assert.ok(!("metadata" in found[0]) && !("leg" in found[0]));
+});
+
+test("ignores waivers, strings and duplicates", () => {
+  const found = findTrades({ a: [{ transaction_id: "w", type: "waiver", roster_ids: [1] }, "text", trade("9"), trade("9")] });
+  assert.deepEqual(found.map(t => t.transactionId), ["9"]);
+});
+
+test("falls back to the page's league id", () => {
+  assert.equal(findTrades([trade("5")], "777")[0].leagueId, "777");
+});
+
+test("caps depth at 12 and results at 200, never throws", () => {
+  let deep: any = trade("deep");
+  for (let i = 0; i < 13; i++) deep = { x: deep };
+  assert.deepEqual(findTrades(deep), []);
+  const many = Array.from({ length: 250 }, (_, i) => trade(String(i)));
+  assert.equal(findTrades(many).length, 200);
+  assert.deepEqual(findTrades("not json"), []);
+  assert.deepEqual(findTrades(null), []);
+});
+
+test("reads the league id from a Sleeper page URL", () => {
+  assert.equal(leagueIdFromUrl("https://sleeper.com/leagues/1180/trades"), "1180");
+  assert.equal(leagueIdFromUrl("https://sleeper.com/"), null);
+});
+
+test("converts back to Sleeper's transaction shape", () => {
+  const tx = toTransaction(findTrades(payload)[0]) as any;
+  assert.deepEqual(tx.roster_ids, [1, 4]);
+  assert.equal(tx.transaction_id, "9");
+  assert.equal(tx.type, "trade");
+});
diff --git a/tests/extension/extensionTrades.test.ts b/tests/extension/extensionTrades.test.ts
new file mode 100644
index 0000000..b4d969c
--- /dev/null
+++ b/tests/extension/extensionTrades.test.ts
@@ -0,0 +1,53 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { freshExtensionTrades, seenAgo, type ExtensionTrade } from "../../app/services/extensionTrades";
+
+const DAY = 86_400_000;
+const NOW = 1_800_000_000_000;
+const t = (id: string, status: string, seenAt: number): ExtensionTrade => ({
+  transactionId: id, leagueId: "1", status, type: "trade", creator: null, rosterIds: [1, 2],
+  adds: {}, drops: {}, draftPicks: [], waiverBudget: [], created: null, seenAt,
+});
+
+test("only pending offers seen in the last 14 days, newest first", () => {
+  const out = freshExtensionTrades(
+    [t("old", "proposed", NOW - 15 * DAY), t("done", "complete", NOW), t("a", "proposed", NOW - DAY), t("b", "pending", NOW - 1000)],
+    NOW
+  );
+  assert.deepEqual(out.map(x => x.transactionId), ["b", "a"]);
+});
+
+test("seen times read naturally", () => {
+  assert.equal(seenAgo(NOW - 59_000, NOW), "just now");
+  assert.equal(seenAgo(NOW - 3 * 60_000, NOW), "3m ago");
+  assert.equal(seenAgo(NOW - 2 * 3_600_000, NOW), "2h ago");
+  assert.equal(seenAgo(NOW - 4 * DAY, NOW), "4d ago");
+});
+
+import { offerSourceLabel, draftPickLines } from "../../app/services/extensionTrades";
+
+test("offers from the extension say where they came from", () => {
+  const seen = new Map([["9", NOW - 3 * 60_000]]);
+  assert.equal(offerSourceLabel({ transactionId: "9", source: "extension" }, seen, NOW), "via browser extension · seen 3m ago");
+  assert.equal(offerSourceLabel({ transactionId: "9", source: "extension" }, new Map(), NOW), "via browser extension");
+  assert.equal(offerSourceLabel({ transactionId: "8", source: "sleeper" }, seen, NOW), "");
+});
+
+test("draft picks in a trade read as text for each side", () => {
+  const picks = [
+    { season: "2027", round: 2, roster_id: 4, owner_id: 1, previous_owner_id: 4 },
+    { season: "2026", round: 1, roster_id: 1, owner_id: 4, previous_owner_id: 1 },
+  ];
+  assert.deepEqual(draftPickLines(picks, 1), { get: ["2027 2nd round pick"], give: ["2026 1st round pick"] });
+  assert.deepEqual(draftPickLines(undefined, 1), { get: [], give: [] });
+});
+
+import { newlyLinked } from "../../app/services/extensionTrades";
+
+test("a browser counts as just linked when it's new or its link time changed", () => {
+  const before = new Map([["e1", 100]]);
+  assert.equal(newlyLinked(before, [{ id: "e1", linkedAt: 100 }]), false);
+  assert.equal(newlyLinked(before, [{ id: "e1", linkedAt: 250 }]), true); // same browser re-linked
+  assert.equal(newlyLinked(before, [{ id: "e1", linkedAt: 100 }, { id: "e2", linkedAt: 5 }]), true);
+  assert.equal(newlyLinked(before, []), false);
+});
