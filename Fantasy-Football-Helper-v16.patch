diff --git a/scripts/build-extension.mjs b/scripts/build-extension.mjs
new file mode 100644
index 0000000..8b251b8
--- /dev/null
+++ b/scripts/build-extension.mjs
@@ -0,0 +1,40 @@
+// scripts/build-extension.mjs
+// Builds the FF Helper browser extension into extension/dist/ and zips it to
+// public/ffhelper-extension.zip (what the app's Download button serves).
+//   npm run build:extension
+
+import { build } from 'esbuild';
+import { zipSync } from 'fflate';
+import { copyFileSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs';
+import { join, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('..', import.meta.url));
+const src = join(root, 'extension/src');
+const dist = join(root, 'extension/dist');
+
+rmSync(dist, { recursive: true, force: true });
+mkdirSync(dist, { recursive: true });
+
+const common = { bundle: true, minify: false, target: 'chrome111', logLevel: 'warning', legalComments: 'none' };
+// Content scripts and the popup are classic scripts; the background worker is a module.
+await build({ ...common, entryPoints: ['content-main', 'content-relay', 'popup'].map(n => join(src, `${n}.ts`)), outdir: dist, format: 'iife' });
+await build({ ...common, entryPoints: [join(src, 'background.ts')], outdir: dist, format: 'esm' });
+
+copyFileSync(join(root, 'extension/manifest.json'), join(dist, 'manifest.json'));
+copyFileSync(join(src, 'popup.html'), join(dist, 'popup.html'));
+copyFileSync(join(root, 'assets/icon.png'), join(dist, 'icon.png'));
+copyFileSync(join(root, 'extension/PRIVACY.md'), join(dist, 'PRIVACY.md'));
+
+const files = {};
+const walk = dir => {
+  for (const name of readdirSync(dir)) {
+    const p = join(dir, name);
+    if (statSync(p).isDirectory()) walk(p);
+    else files[`ffhelper-extension/${relative(dist, p)}`] = readFileSync(p);
+  }
+};
+walk(dist);
+mkdirSync(join(root, 'public'), { recursive: true });
+writeFileSync(join(root, 'public/ffhelper-extension.zip'), zipSync(files, { level: 9 }));
+console.log(`Built extension/dist (${Object.keys(files).length} files) and public/ffhelper-extension.zip`);
diff --git a/scripts/e2e-extension.mjs b/scripts/e2e-extension.mjs
new file mode 100644
index 0000000..1665796
--- /dev/null
+++ b/scripts/e2e-extension.mjs
@@ -0,0 +1,68 @@
+// scripts/e2e-extension.mjs
+// End-to-end check of the built extension (npm run build:extension first): loads it in Chromium,
+// serves a fake sleeper.com page that fetches a GraphQL response with a pending trade, and checks
+// the popup's "Check what I see" lists it. Nothing touches the real Sleeper or Firebase.
+//   node scripts/e2e-extension.mjs
+
+import { createRequire } from 'node:module';
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// Playwright may be installed globally; require() finds it where import can't.
+const { chromium } = createRequire(import.meta.url)('playwright');
+const dist = fileURLToPath(new URL('../extension/dist', import.meta.url));
+const shot = process.argv[2];
+
+const graphql = {
+  data: {
+    league_transactions_filtered: [
+      { transaction_id: '9', type: 'trade', status: 'proposed', league_id: '1180', roster_ids: [1, 4], creator: 'u4',
+        adds: { '6794': 1, '4866': 4 }, drops: { '6794': 4, '4866': 1 }, metadata: { note: 'not captured' } },
+    ],
+  },
+};
+const page = `<!doctype html><title>Sleeper</title><p>league</p><script>
+  // One XHR object reused twice (Sleeper-style polling), then a fetch.
+  const x = new XMLHttpRequest();
+  x.onload = () => { x.onload = null; x.open('POST', 'https://sleeper.com/graphql'); x.send('{}'); };
+  x.open('POST', 'https://sleeper.com/graphql'); x.send('{}');
+  fetch('https://sleeper.com/graphql', { method: 'POST', body: '{}' }).then(r => r.json()).then(() => setTimeout(() => document.title = 'loaded', 500));
+</script>`;
+
+const ctx = await chromium.launchPersistentContext(mkdtempSync(join(tmpdir(), 'ffh-ext-')), {
+  headless: true,
+  channel: 'chromium', // the full Chromium build (new headless) can load extensions
+  args: [`--disable-extensions-except=${dist}`, `--load-extension=${dist}`],
+});
+// Keep everything offline: fake Sleeper, block Firebase.
+await ctx.route('https://sleeper.com/graphql', r => r.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(graphql) }));
+await ctx.route('https://sleeper.com/leagues/**', r => r.fulfill({ status: 200, contentType: 'text/html', body: page }));
+await ctx.route(/googleapis\.com/, r => r.abort());
+
+let [worker] = ctx.serviceWorkers();
+worker ??= await ctx.waitForEvent('serviceworker');
+const extId = new URL(worker.url()).host;
+
+const tab = await ctx.newPage();
+await tab.goto('https://sleeper.com/leagues/1180/trades');
+await tab.waitForFunction(() => document.title === 'loaded');
+await tab.waitForTimeout(1500);
+
+const popup = await ctx.newPage();
+await popup.setViewportSize({ width: 340, height: 420 });
+await popup.goto(`chrome-extension://${extId}/popup.html`);
+const status = await popup.evaluate(() => chrome.runtime.sendMessage({ type: 'status' }));
+const captured = status.captures.filter(c => c.transactionId === '9' && c.status === 'proposed');
+console.log(`captured ${captured.length} trade(s); rosters ${captured[0]?.rosterIds?.join(', ')}; league ${captured[0]?.leagueId}; saw Sleeper: ${status.seenSleeper}`);
+
+// Wrong-shaped code is rejected before any network call.
+await popup.fill('#code', 'abc');
+await popup.click('button[type=submit]');
+await popup.waitForTimeout(300);
+console.log(`bad code message: ${await popup.textContent('#error')}`);
+if (shot) await popup.screenshot({ path: shot });
+
+await ctx.close();
+if (captured.length !== 1 || !status.seenSleeper) process.exit(1);
diff --git a/tests-rules/rules.test.cjs b/tests-rules/rules.test.cjs
new file mode 100644
index 0000000..273dde1
--- /dev/null
+++ b/tests-rules/rules.test.cjs
@@ -0,0 +1,96 @@
+// Firestore rules tests. Needs Java + the Firebase emulator:
+//   npx -p firebase-tools -p @firebase/rules-unit-testing firebase emulators:exec --only firestore --project demo-ffh "node --test tests-rules/rules.test.cjs"
+const { test, before, after, beforeEach } = require("node:test");
+const fs = require("node:fs");
+const path = require("node:path");
+const { initializeTestEnvironment, assertSucceeds, assertFails } = require("@firebase/rules-unit-testing");
+// Use the same Firebase copy as @firebase/rules-unit-testing (not the app's).
+const fsPath = require.resolve("firebase/firestore", { paths: [path.dirname(require.resolve("@firebase/rules-unit-testing"))] });
+const { doc, getDoc, setDoc, updateDoc, deleteDoc, Timestamp, serverTimestamp } = require(fsPath);
+
+let env;
+const MIN = 60 * 1000;
+const ts = ms => Timestamp.fromMillis(Date.now() + ms);
+
+before(async () => {
+  env = await initializeTestEnvironment({
+    projectId: "demo-ffh",
+    firestore: { rules: fs.readFileSync(path.join(__dirname, "..", "firestore.rules"), "utf8") },
+  });
+});
+after(() => env.cleanup());
+beforeEach(() => env.clearFirestore());
+
+const as = uid => env.authenticatedContext(uid).firestore();
+const seed = (p, data) => env.withSecurityRulesDisabled(c => setDoc(doc(c.firestore(), p), data));
+// Seeded pairings (rules disabled) use explicit times; app-created ones use the server's clock.
+const pairingDoc = (over = {}) => ({ uid: "alice", label: "Alice", createdAt: ts(0), claimedBy: null, ...over });
+const newPairing = (over = {}) => ({ uid: "alice", label: "Alice", createdAt: serverTimestamp(), claimedBy: null, ...over });
+const trade = id => ({ transactionId: id, leagueId: "1", status: "proposed", type: "trade", creator: "u", rosterIds: [1, 2], adds: {}, drops: {}, draftPicks: [], waiverBudget: [], created: 1, seenAt: 1, capturedAt: 1, source: "extension" });
+
+test("owner can save to their own account document (favorites, my team)", async () => {
+  await assertSucceeds(setDoc(doc(as("alice"), "users/alice"), { favorites: { players: [], teams: [] } }, { merge: true }));
+  await assertFails(setDoc(doc(as("bob"), "users/alice"), { x: 1 }));
+});
+
+test("leagues stay owner-only", async () => {
+  await assertSucceeds(setDoc(doc(as("alice"), "users/alice/leagues/1"), { leagueId: "1" }));
+  await assertFails(getDoc(doc(as("bob"), "users/alice/leagues/1")));
+});
+
+test("app can create a pairing code for itself only, timed by the server clock", async () => {
+  await assertSucceeds(setDoc(doc(as("alice"), "extensionPairings/ABCDEFGH"), newPairing()));
+  await assertFails(setDoc(doc(as("alice"), "extensionPairings/ABCDEFGJ"), newPairing({ uid: "bob" })));
+  // A device clock that's off can't set the time (skewed createdAt is rejected).
+  await assertFails(setDoc(doc(as("alice"), "extensionPairings/ABCDEFGK"), newPairing({ createdAt: ts(5 * MIN) })));
+});
+
+test("extension claims a fresh code once, then links itself", async () => {
+  await seed("extensionPairings/ABCDEFGH", pairingDoc());
+  const ext = as("ext1");
+  await assertSucceeds(updateDoc(doc(ext, "extensionPairings/ABCDEFGH"), { claimedBy: "ext1" }));
+  await assertFails(updateDoc(doc(as("ext2"), "extensionPairings/ABCDEFGH"), { claimedBy: "ext2" }));
+  await assertSucceeds(setDoc(doc(ext, "users/alice/linkedDevices/ext1"), { code: "ABCDEFGH", browser: "Chrome", linkedAt: 1, lastSyncAt: null, version: "1.0.0" }));
+  // another extension can't link with someone else's claim
+  await assertFails(setDoc(doc(as("ext2"), "users/alice/linkedDevices/ext2"), { code: "ABCDEFGH", browser: "x", linkedAt: 1, lastSyncAt: null, version: "1" }));
+});
+
+test("expired codes can't be read or claimed", async () => {
+  await seed("extensionPairings/OLDCODE2", pairingDoc({ createdAt: ts(-11 * MIN) }));
+  await assertFails(getDoc(doc(as("ext1"), "extensionPairings/OLDCODE2")));
+  await assertFails(updateDoc(doc(as("ext1"), "extensionPairings/OLDCODE2"), { claimedBy: "ext1" }));
+});
+
+test("only a linked extension can save trades, and only the owner can read them", async () => {
+  await assertFails(setDoc(doc(as("ext1"), "users/alice/pendingTrades/9"), trade("9")));
+  await seed("users/alice/linkedDevices/ext1", { code: "ABCDEFGH", browser: "x", linkedAt: 1, lastSyncAt: null, version: "1" });
+  await assertSucceeds(setDoc(doc(as("ext1"), "users/alice/pendingTrades/9"), trade("9")));
+  await assertFails(setDoc(doc(as("ext1"), "users/alice/pendingTrades/9"), { ...trade("9"), token: "secret" }));
+  await assertSucceeds(getDoc(doc(as("alice"), "users/alice/pendingTrades/9")));
+  await assertFails(getDoc(doc(as("bob"), "users/alice/pendingTrades/9")));
+  await assertFails(getDoc(doc(as("ext1"), "users/alice/pendingTrades/9")));
+});
+
+test("after unlinking, the extension can't save anymore", async () => {
+  await seed("users/alice/linkedDevices/ext1", { code: "ABCDEFGH", browser: "x", linkedAt: 1, lastSyncAt: null, version: "1" });
+  await assertSucceeds(deleteDoc(doc(as("alice"), "users/alice/linkedDevices/ext1")));
+  await assertFails(setDoc(doc(as("ext1"), "users/alice/pendingTrades/9"), trade("9")));
+});
+
+test("an extension can unlink itself, but not other browsers", async () => {
+  await seed("users/alice/linkedDevices/ext1", { code: "ABCDEFGH", browser: "x", linkedAt: 1, lastSyncAt: null, version: "1" });
+  await seed("users/alice/linkedDevices/ext2", { code: "ABCDEFGJ", browser: "y", linkedAt: 1, lastSyncAt: null, version: "1" });
+  await assertFails(deleteDoc(doc(as("ext1"), "users/alice/linkedDevices/ext2")));
+  await assertSucceeds(deleteDoc(doc(as("ext1"), "users/alice/linkedDevices/ext1")));
+});
+
+test("a browser whose device record still exists can re-link with a new code (remove, then add)", async () => {
+  await seed("users/alice/linkedDevices/ext1", { code: "OLDCODE2", browser: "x", linkedAt: 1, lastSyncAt: null, version: "1" });
+  await seed("extensionPairings/NEWCODE2", pairingDoc({ claimedBy: "ext1" }));
+  const ext = as("ext1");
+  // Overwriting the old record is an update, which only allows sync fields:
+  await assertFails(setDoc(doc(ext, "users/alice/linkedDevices/ext1"), { code: "NEWCODE2", browser: "y", linkedAt: 2, lastSyncAt: null, version: "1" }));
+  // ...so the extension removes its own record first, then creates it again.
+  await assertSucceeds(deleteDoc(doc(ext, "users/alice/linkedDevices/ext1")));
+  await assertSucceeds(setDoc(doc(ext, "users/alice/linkedDevices/ext1"), { code: "NEWCODE2", browser: "y", linkedAt: 2, lastSyncAt: null, version: "1" }));
+});
diff --git a/tests/backend/extension.test.ts b/tests/backend/extension.test.ts
new file mode 100644
index 0000000..66662c8
--- /dev/null
+++ b/tests/backend/extension.test.ts
@@ -0,0 +1,49 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { validateExtraTransactions, mergeTransactions } from "../../app/backend/utils/extraTransactions";
+import { pendingTradesFor } from "../../app/backend/services/tradeGrade";
+
+const tx = (id: string, extra: Record<string, unknown> = {}) => ({
+  transaction_id: id, type: "trade", status: "proposed", roster_ids: [1, 4], creator: "u4",
+  adds: { a: 1, b: 4 }, drops: { a: 4, b: 1 }, draft_picks: [], ...extra,
+});
+
+test("extension trades: at most 50, must be trades involving your roster", () => {
+  assert.equal(validateExtraTransactions(Array.from({ length: 60 }, (_, i) => tx(String(i))), 1).length, 50);
+  assert.deepEqual(validateExtraTransactions([tx("x", { roster_ids: [2, 3] })], 1), []);
+  assert.deepEqual(validateExtraTransactions([tx("x", { adds: { "1": "x" } })], 1), []);
+  assert.deepEqual(validateExtraTransactions([tx("x", { type: "waiver" })], 1), []);
+  assert.deepEqual(validateExtraTransactions("nope", 1), []);
+});
+
+test("a trade Sleeper already finished doesn't show as pending", () => {
+  const merged = mergeTransactions([tx("9", { status: "complete" })], [tx("9")]);
+  assert.deepEqual(pendingTradesFor(merged, 1, "u1", new Set(["9"])), []);
+});
+
+test("extension-only trades are marked as coming from the extension", () => {
+  const merged = mergeTransactions([], validateExtraTransactions([tx("9")], 1));
+  const [t] = pendingTradesFor(merged, 1, "u1", new Set(["9"]));
+  assert.equal(t.source, "extension");
+  assert.equal(t.direction, "received");
+  assert.deepEqual(t.get, ["a"]);
+  assert.deepEqual(t.give, ["b"]);
+});
+
+test("draft-pick-only trades are kept with their picks", () => {
+  const pick = { season: "2027", round: 2, roster_id: 4, owner_id: 1, previous_owner_id: 4 };
+  const merged = mergeTransactions([], validateExtraTransactions([tx("p", { adds: {}, drops: {}, draft_picks: [pick] })], 1));
+  const [t] = pendingTradesFor(merged, 1, "u1", new Set(["p"]));
+  assert.deepEqual(t.give, []);
+  assert.deepEqual(t.get, []);
+  assert.deepEqual(t.draftPicks, [pick]);
+});
+
+import { tradeFitsLeague } from "../../app/backend/utils/extraTransactions";
+
+test("extension trades must only move players from this league's rosters", () => {
+  const rostered = new Set(["a", "b", "c"]);
+  assert.equal(tradeFitsLeague(tx("1"), rostered), true);
+  assert.equal(tradeFitsLeague(tx("2", { adds: { zz: 1 }, drops: { zz: 4 } }), rostered), false); // another league's player
+  assert.equal(tradeFitsLeague(tx("3", { adds: {}, drops: {} }), rostered), true); // picks only
+});
